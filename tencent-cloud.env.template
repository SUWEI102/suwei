# 仅为格式模板，不得在此文件填写或提交真实值。
# 密码中的 @、#、%、/、: 等字符必须 URL 编码。
TENCENT_MYSQL_URL=mysql://suwei_app:<URL_ENCODED_PASSWORD>@<TENCENT_PUBLIC_HOST>:<PUBLIC_PORT>/suwei_rental

# 64 个十六进制字符，即 32 字节 AES-256 密钥。
TENCENT_BACKUP_KEY=<64_HEX_CHARACTERS>

# 可选：完整 PEM；在 Vercel Vars 中可直接粘贴多行内容。
TENCENT_MYSQL_CA=<PEM_CA_CERTIFICATE>

# Vercel Cron 请求鉴权密钥。
CRON_SECRET=<RANDOM_SECRET>
